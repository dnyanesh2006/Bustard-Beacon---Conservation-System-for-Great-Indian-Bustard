# ==============================================================================
# Bustard Beacon — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Django Security Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-in-production
DEBUG=True

# Database Configuration
# Leave blank to automatically use the default local SQLite database (db.sqlite3).
# Or populate the fields below to connect to a production MySQL / MariaDB instance.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Google Maps JavaScript API
# Required for interactive GIS spatial maps (Sanctuary Map, Incident GIS, Landing Page)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 (Optional — for Google Single Sign-On)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/
