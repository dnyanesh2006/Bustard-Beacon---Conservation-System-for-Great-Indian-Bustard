# ==============================================================================
# Bustard Beacon — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Django Security Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-in-production
DEBUG=True

# Database Configuration
# Leave blank to automatically use the default local SQLite database (db.sqlite3).
# Or populate the fields below to connect to a production MySQL / MariaDB instance.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Google Maps JavaScript API
# Required for interactive GIS spatial maps (Sanctuary Map, Incident GIS, Landing Page)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 (Optional — for Google Single Sign-On)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# ==============================================================================
# Email & SMTP Configuration (Password Reset & Account Setup Invitations)
# ==============================================================================
# For live production email delivery (e.g., Google Gmail SMTP):
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the values below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_organization_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL="Bustard Beacon Administration" <your_organization_email@gmail.com>

# For local development without SMTP, leave EMAIL_HOST and EMAIL_HOST_USER blank.
# Django will automatically use the console backend and print outgoing emails to stdout/terminal.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
